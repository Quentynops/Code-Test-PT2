
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Game Boy Arcade</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 24px 16px;
      background: #10131b;
      color: #f4f6fa;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    h1 {
      color: #86efac;
      margin-bottom: 8px;
    }

    p { color: #b9c2d0; }

    .panel {
      max-width: 1000px;
      margin: 24px auto;
      padding: 20px;
      background: #1c2230;
      border: 1px solid #343d4f;
      border-radius: 14px;
    }

    input, button {
      max-width: 100%;
      margin: 8px;
      padding: 12px;
      border-radius: 8px;
      font-size: 15px;
    }

    input {
      background: #fff;
      color: #111;
    }

    button {
      border: 0;
      background: #86efac;
      color: #102016;
      font-weight: bold;
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    #status {
      min-height: 24px;
      overflow-wrap: anywhere;
    }

    #game {
      width: 100%;
      max-width: 960px;
      min-height: 300px;
      margin: 20px auto 0;
      background: #000;
      border-radius: 8px;
      overflow: hidden;
    }

    #game canvas {
      max-width: 100%;
    }

    .hint {
      font-size: 13px;
      line-height: 1.6;
    }
  </style>
</head>

<body>
  <h1>GAME BOY ARCADE</h1>
  <p>One player. Three generations. Your games.</p>

  <main class="panel">
    <h2>Choose a game</h2>

    <p class="hint">
      Game Boy: .gb<br>
      Game Boy Color: .gbc<br>
      Game Boy Advance: .gba
    </p>

    <input
      type="file"
      id="rom"
      accept=".gb,.gbc,.gba"
    >

    <br>

    <button id="start">Load Game</button>
    <button id="fullscreen" disabled>Fullscreen</button>

    <p id="status" role="status">
      Select a game file to begin.
    </p>

    <div id="game"></div>
  </main>

  <p class="hint">
    Use the emulator's displayed controls or configure your keyboard
    in its settings. Keep your own game files private.
  </p>

  <script>
    const picker = document.getElementById("rom");
    const startButton = document.getElementById("start");
    const fullscreenButton = document.getElementById("fullscreen");
    const status = document.getElementById("status");
    const game = document.getElementById("game");

    let emulatorLoading = false;
    let gameObjectUrl = null;

    startButton.addEventListener("click", () => {
      if (emulatorLoading) return;

      const file = picker.files[0];

      if (!file) {
        status.textContent = "Please choose a .gb, .gbc, or .gba file.";
        return;
      }

      const extension = file.name
        .split(".")
        .pop()
        .toLowerCase();

      let system;

      if (extension === "gba") {
        system = "gba";
      } else if (extension === "gb" || extension === "gbc") {
        system = "gb";
      } else {
        status.textContent = "Unsupported file type.";
        return;
      }

      emulatorLoading = true;
      startButton.disabled = true;
      fullscreenButton.disabled = true;
      status.textContent = "Loading " + file.name + "...";

      if (gameObjectUrl) {
        URL.revokeObjectURL(gameObjectUrl);
      }

      gameObjectUrl = URL.createObjectURL(file);

      // EmulatorJS configuration must be set before loader.js runs.
      window.EJS_player = "#game";
      window.EJS_gameName = file.name;
      window.EJS_gameUrl = gameObjectUrl;
      window.EJS_core = system;
      window.EJS_pathtodata =
        "https://cdn.emulatorjs.org/stable/data/";

      window.EJS_startOnLoaded = true;
window.EJS_Buttons = {
  saveState: true,
  loadState: true,
  saveSavFiles: true,
  loadSavFiles: true,
  quickSave: true,
  quickLoad: true,
  fullscreen: true,
  settings: true
};
      // Remove a previous emulator before starting another.
      game.replaceChildren();

      const oldLoader = document.getElementById("emulator-loader");
      if (oldLoader) oldLoader.remove();

      const script = document.createElement("script");
      script.id = "emulator-loader";
      script.src = window.EJS_pathtodata + "loader.js";

      script.onload = () => {
        status.textContent =
          "Emulator loaded. If the game does not start, check the console.";
        fullscreenButton.disabled = false;
        emulatorLoading = false;
        startButton.disabled = false;
      };

      script.onerror = () => {
        status.textContent =
          "Could not load EmulatorJS. Check your internet connection or whether the CDN is blocked.";
        emulatorLoading = false;
        startButton.disabled = false;
      };

      document.body.appendChild(script);
    });

    fullscreenButton.addEventListener("click", () => {
      const target = game;

      if (target.requestFullscreen) {
        target.requestFullscreen().catch(() => {
          status.textContent =
            "Fullscreen is unavailable in this browser.";
        });
      }
    });
  </script>
</body>
</html>
